# APIFY_API_TOKEN: Apify API token for apify/instagram-profile-scraper (backend or fallback REST).
# APIFY_BACKEND_URL: Optional secure backend base URL (e.g. https://your-backend.example.com).
# Configure these via the Secrets panel in the AI Studio UI.
APIFY_BACKEND_URL=MY_APIFY_BACKEND_URL
APIFY_API_TOKEN=MY_APIFY_API_TOKEN
APIFY_TOKEN=MY_APIFY_TOKEN
