# =====================================================================
# SUPABASE CONFIGURATION (Shared Project)
# =====================================================================
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Anon / Publishable Key (used by Android client & public requests)
SUPABASE_PUBLISHABLE_KEY=

# Service Role Secret Key (used ONLY by Discord bot & backend administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret Key (from Supabase Project Settings -> API)
SUPABASE_JWT_SECRET=

# =====================================================================
# APIFY API TOKENS (Primary + 7 Automatic Fallback Backup Tokens)
# When the primary token credits expire (402) or error (401/403/429),
# the app and backend automatically rotate to Backup 1 -> 7.
# =====================================================================
APIFY_API_TOKEN=
APIFY_TOKEN=
APIFY_BACKUP_TOKEN_1=
APIFY_BACKUP_TOKEN_2=
APIFY_BACKUP_TOKEN_3=
APIFY_BACKUP_TOKEN_4=
APIFY_BACKUP_TOKEN_5=
APIFY_BACKUP_TOKEN_6=
APIFY_BACKUP_TOKEN_7=

# Optional: Companion backend proxy URL if running Node server
APIFY_BACKEND_URL=
